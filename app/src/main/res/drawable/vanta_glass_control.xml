<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vanta_glass_fill_pressed" />
            <stroke android:width="@dimen/vanta_glass_stroke" android:color="@color/vanta_glass_border" />
            <corners android:radius="@dimen/vanta_radius_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vanta_glass_fill" />
            <stroke android:width="@dimen/vanta_glass_stroke" android:color="@color/vanta_glass_border_soft" />
            <corners android:radius="@dimen/vanta_radius_pill" />
        </shape>
    </item>
</selector>
